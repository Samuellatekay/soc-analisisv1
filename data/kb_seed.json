    "id": "playbook:brute_force",
    "attack_type": "brute_force",
    "title": "Playbook brute force",
    "steps": [
     "Blokir/rate-limit IP sumber di firewall",
     "Reset kredensial akun yang ditargetkan; paksa MFA",
     "Periksa login sukses setelah rentetan gagal",
     "Tinjau host target untuk persistensi"
    ]

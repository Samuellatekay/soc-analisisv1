# TEMPLATE KONFIGURASI
# Salin file ini menjadi .env, lalu ubah hanya pengaturan yang Anda perlukan.
# Jangan masukkan password, token sungguhan, atau kunci privat ke file ini atau ke Git.
# Nilai di bawah adalah contoh untuk development; bukan konfigurasi aman untuk produksi.
#
# Pilih mode:
# - Single: DATABASE_URL SQLite, INGEST_MODE=inline, EMBEDDED_WORKERS=true.
# - Orkestrasi (Compose): Compose mengganti database, Redis, Elasticsearch, Neo4j,
#   INGEST_MODE, dan EMBEDDED_WORKERS sesuai kebutuhan service.
# - Master: Master dipasang terpisah; set MASTER_* hanya pada cluster yang dikelola.
#
# Untuk secret, aplikasi membaca NAMA_FILE bila file tersebut tersedia; jika tidak,
# aplikasi membaca NAMA. Path *_FILE harus dapat diakses dari proses/container terkait.

# ---------------------------------------------------------------------------
# 1. DATABASE DAN PEMROSESAN ALERT
# ---------------------------------------------------------------------------
# Single menggunakan SQLite lokal. Compose mengatur PostgreSQL secara otomatis.
DATABASE_URL=sqlite:///data/soc.db

# inline = proses antrean di dalam API (pilihan untuk Single/development).
# queue  = kirim event ke Redis; perlu REDIS_URL dan worker engine aktif.
INGEST_MODE=inline

# true  = worker berjalan di dalam API.
# false = worker harus dijalankan sebagai service/proses terpisah (seperti Compose).
EMBEDDED_WORKERS=true

# ---------------------------------------------------------------------------
# 2. LOGIN DAN OTORISASI API
# ---------------------------------------------------------------------------
# Format API_TOKENS: token:role:tenant,token:role:tenant
# Role yang digunakan: admin, analyst, viewer.
# Token berikut hanya untuk demo lokal. Ganti sebelum aplikasi dapat diakses pihak lain.
API_TOKENS=dev-admin-token:admin:default,dev-analyst-token:analyst:default,dev-viewer-token:viewer:default

# Kunci untuk mengirim alert ke endpoint ingest.
# Format: key:tenant. Ini berbeda dari token login/API di atas.
# Untuk penggunaan nyata, gunakan INGEST_API_KEY_FILE atau secret manager.
INGEST_API_KEY=dev-ingest-key:default

# ---------------------------------------------------------------------------
# 3. LOGIN SSO (OIDC) - OPSIONAL
# ---------------------------------------------------------------------------
# Kosong = gunakan API_TOKENS. Isi OIDC_ISSUER untuk mengaktifkan login melalui IdP.
# Saat OIDC aktif, token statis ditolak kecuali ALLOW_STATIC_TOKENS=true.
OIDC_ISSUER=
OIDC_AUDIENCE=soc-api

# ID client UI publik. Gunakan Authorization Code + PKCE; jangan taruh client secret di UI.
OIDC_CLIENT_ID=soc-ui
OIDC_SCOPE=openid profile email

# Contoh parameter tambahan Auth0:
# OIDC_AUTH_EXTRA_PARAMS={"audience":"soc-api"}

# Biasanya endpoint ditemukan otomatis dari OIDC_ISSUER/.well-known/openid-configuration.
# Isi hanya jika IdP tidak menyediakan discovery atau perlu endpoint khusus.
# OIDC_AUTH_URL=
# OIDC_TOKEN_URL=
# OIDC_LOGOUT_URL=
# OIDC_JWKS_URL=

# Nama klaim peran dan tenant dari token IdP.
# Contoh role claim: Keycloak realm_access.roles, Entra roles, Okta groups.
OIDC_ROLE_CLAIM=roles
OIDC_ROLE_MAP={"soc-admin":"admin","soc-analyst":"analyst","soc-viewer":"viewer"}
OIDC_TENANT_CLAIM=tenant_id

# Tetap false agar token statis tidak menjadi jalur login tambahan saat OIDC aktif.
ALLOW_STATIC_TOKENS=false

# ---------------------------------------------------------------------------
# 4. LAYANAN DATA DAN MODEL - OPSIONAL
# ---------------------------------------------------------------------------
# Kosong = layanan terkait tidak digunakan; aplikasi memakai fallback yang tersedia.
# Compose mengatur REDIS_URL, Elasticsearch, dan Neo4j untuk service stack.
REDIS_URL=
ELASTICSEARCH_URL=
# API key untuk Elasticsearch yang mengaktifkan autentikasi; kosong untuk layanan lokal tanpa auth.
# Aplikasi memakai header Authorization: ApiKey. Secret file: ELASTICSEARCH_API_KEY_FILE.
ELASTICSEARCH_API_KEY_FILE=
NEO4J_URI=
NEO4J_USER=neo4j

# Secret Neo4j. Gunakan NEO4J_PASSWORD_FILE di container atau NEO4J_PASSWORD
# untuk development lokal. Jangan simpan password sungguhan di Git.
NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password

# Provider yang dipakai worker RAG:
# auto = jika OLLAMA_URL + OLLAMA_MODEL terisi, pakai Ollama; selain itu analisis template.
# none = selalu pakai analisis template (tanpa panggilan ke AI).
# ollama | openai | gemini | openai_compatible = pilih provider secara eksplisit.
LLM_PROVIDER=auto

# Gemini, OpenAI, dan provider kompatibel OpenAI memakai model dan kunci API ini.
# Kunci dibaca dari LLM_API_KEY_FILE bila file tersedia; selain itu dari LLM_API_KEY.
# Jangan commit kunci. Untuk API cloud, data alert dan bukti RAG dikirim ke provider.
LLM_MODEL=
LLM_API_KEY=
# Untuk Docker secret, isi path di dalam container, misalnya /run/secrets/llm_api_key,
# lalu mount secret itu ke service rag_worker pada infra/docker-compose.yml.
LLM_API_KEY_FILE=

# OpenAI memakai https://api.openai.com/v1 bila kosong.
# Gemini memakai https://generativelanguage.googleapis.com/v1beta bila kosong.
# Provider openai_compatible wajib mengisi URL base, misalnya https://provider.example/v1.
LLM_BASE_URL=
LLM_TIMEOUT=60

# Ollama berjalan di luar stack Compose. Bila dipilih, isi URL dan model lokalnya.
# LLM_PROVIDER=ollama memerlukan keduanya. Pada LLM_PROVIDER=auto, keduanya
# mempertahankan perilaku lama: Ollama dipakai bila keduanya terisi.
OLLAMA_URL=
OLLAMA_MODEL=
# OLLAMA_TIMEOUT lama tetap dibaca sebagai default LLM_TIMEOUT jika LLM_TIMEOUT kosong.
PROMPT_VERSION=analysis_v1

# Opsional: direktori model Hugging Face hasil fine-tuning.
# Label model yang diharapkan: 0 = false positive, 1 = true positive.
BERT_MODEL_PATH=

# ---------------------------------------------------------------------------
# 5. KONEKTOR SIEM / EDR - OPSIONAL
# ---------------------------------------------------------------------------
# Salin infra/config/connectors.example.json menjadi connectors.json,
# lalu aktifkan konektor yang dibutuhkan di file tersebut.
CONNECTORS_CONFIG=infra/config/connectors.json

# true  = konektor berjalan di dalam API (mode Single).
# false = konektor hanya berjalan di service connectors terpisah (mode Compose).
EMBEDDED_CONNECTORS=true

# Secret konektor disimpan di environment/secret manager, bukan di connectors.json.
# Nama variabel di bawah harus cocok dengan *_env pada konfigurasi konektor.
# Contoh:
# SPLUNK_TOKEN=
# SENTINEL_CLIENT_SECRET=
# QRADAR_TOKEN=
# CS_CLIENT_SECRET=
# S1_API_TOKEN=
# DEFENDER_CLIENT_SECRET=
# CORTEX_API_KEY=
# WAZUH_INDEXER_PASSWORD=
# ELASTIC_API_KEY=

# ---------------------------------------------------------------------------
# 6. DATA ASET DAN THREAT INTELLIGENCE
# ---------------------------------------------------------------------------
# GLPI opsional untuk lookup aset. Jika GLPI_URL kosong, gunakan file inventaris lokal.
GLPI_URL=
GLPI_APP_TOKEN_FILE=/run/secrets/glpi_app_token
GLPI_USER_TOKEN_FILE=/run/secrets/glpi_user_token
GLPI_CONFIG=infra/config/glpi.json

# File fallback lokal untuk aset, IOC, dan kerentanan.
ASSET_INVENTORY_FILE=data/assets.json
INTEL_FILE=data/intel.json
VULN_FILE=data/vulns.json

# OpenCTI opsional untuk enrichment IOC. Kosong = lookup IOC lokal dari INTEL_FILE.
OPENCTI_URL=
OPENCTI_TOKEN_FILE=/run/secrets/opencti_token

# Batas waktu satu permintaan enrichment (detik) dan lama cache (detik).
ENRICHMENT_TIMEOUT=2.0
ENRICHMENT_CACHE_TTL=300

# ---------------------------------------------------------------------------
# 7. PENGURANGAN NOISE DAN KONTEKS LINGKUNGAN
# ---------------------------------------------------------------------------
# Parameter analisis. Ubah hanya setelah kalibrasi dengan data SOC Anda.
FFT_MIN_HISTORY_HOURS=48
FFT_PEAK_RATIO=3.0
PCC_THRESHOLD=0.85

# Aktifkan hanya jika kondisi tersebut memang sesuai dengan lingkungan Anda.
ENV_INDUSTRY_CAMPAIGN=false
ENV_NETWORK_WIDE_ANOMALY=false

# ---------------------------------------------------------------------------
# 8. SINKRONISASI KNOWLEDGE BASE
# ---------------------------------------------------------------------------
# KB diperbarui setiap hari pada jam dan zona waktu ini.
KB_SYNC_HOUR=1
KB_SYNC_TZ=Asia/Jakarta

# Abaikan pengetahuan yang lebih lama dari jumlah hari ini.
KB_STALE_DAYS=3

# ---------------------------------------------------------------------------
# 9. MASTER - OPSIONAL, HANYA UNTUK CLUSTER YANG DIKELOLA
# ---------------------------------------------------------------------------
# Kosong = cluster tidak terhubung ke Master.
# MASTER_URL dan CLUSTER_ID harus diisi bersama token tarik dan public key.
MASTER_URL=
CLUSTER_ID=
MASTER_CLUSTER_TOKEN_FILE=/run/secrets/master_cluster_token
MASTER_POLICY_PUBKEY_FILE=/run/secrets/master_policy_pub

# Interval menarik status/policy dari Master (detik).
POLICY_POLL_SECONDS=60
MASTER_CONFIG_POLL_SECONDS=60

# Konfigurasi Master UI. Isi hanya pada environment Master, bukan cluster SOC.
# MASTER_API_TOKENS=token-admin:admin,token-viewer:viewer
# MASTER_DATABASE_URL=postgresql+psycopg://user:password@db.example.com:5432/soc_master?sslmode=require
# MASTER_SIGNING_KEY_FILE=/run/secrets/master_policy.key
# MASTER_CONFIG_ENCRYPTION_KEY_FILE=/run/secrets/master_config.key

# Queue mode: klaim ulang pesan worker yang mati setelah idle (milidetik).
ENGINE_CLAIM_IDLE_MS=60000

# ---------------------------------------------------------------------------
# 10. BACKUP
# ---------------------------------------------------------------------------
# Jadwal cron 5 kolom. Contoh di bawah berarti setiap hari pukul 02:00.
BACKUP_ENABLED=true
BACKUP_SCHEDULE_MODE=cron
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_TIMEZONE=Asia/Jakarta

# Komponen yang akan dicadangkan; hanya masukkan layanan yang memang digunakan.
BACKUP_COMPONENTS=postgres,elasticsearch,neo4j,redis
BACKUP_RETENTION_DAYS=30

# Direktori absolut di dalam runtime/container untuk menyimpan backup.
# Di Compose, direktori /backups tersedia sebagai named volume.
BACKUP_REPOSITORY_URI=/backups
BACKUP_VERIFY_AFTER_RUN=true

# Backup aktif memerlukan file kunci yang benar-benar tersedia di runtime.
# Path ini harus dipasang ke service backup; file secret tidak otomatis dibuat oleh Compose.
# Jika belum mengatur mount key, siapkan terlebih dahulu sebelum menjalankan backup.
# Jangan menyimpan file key di Git.
# Buat key dengan: python -m services.backup.crypto genkey <path-file-key>
# Simpan salinan key di lokasi aman yang terpisah dari backup.
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key

# Opsional: nama snapshot repository Elasticsearch yang sudah didaftarkan.
# Diperlukan hanya jika BACKUP_COMPONENTS mencakup elasticsearch.
BACKUP_ES_REPOSITORY=

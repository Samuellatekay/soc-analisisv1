# Salin ke .env. Hanya NAMA/placeholder: jangan simpan secret asli di sini atau di Git.
# --- Inti
DATABASE_URL=sqlite:///data/soc.db          # produksi: postgresql+psycopg://user:***@host/soc
INGEST_MODE=inline                          # inline (dev) | queue (butuh REDIS_URL + worker engine)
EMBEDDED_WORKERS=true                       # false bila worker dijalankan sebagai proses/container terpisah
# --- Auth (kembangkan ke OIDC/SSO+MFA untuk enterprise). Format: token:role:tenant
API_TOKENS=dev-admin-token:admin:default,dev-analyst-token:analyst:default,dev-viewer-token:viewer:default
INGEST_API_KEY=dev-ingest-key:default       # format key[:tenant]; untuk produksi pakai API_TOKENS_FILE/INGEST_API_KEY_FILE (Docker secret)
# --- SSO/OIDC (opsional; bila OIDC_ISSUER diisi, token statis dimatikan kecuali ALLOW_STATIC_TOKENS=true)
OIDC_ISSUER=
OIDC_AUDIENCE=soc-api
OIDC_CLIENT_ID=soc-ui                        # client PUBLIK PKCE untuk UI (tanpa secret)
OIDC_SCOPE=openid profile email              # Entra: api://<app-id>/.default
# OIDC_AUTH_EXTRA_PARAMS={"audience":"soc-api"}   # mis. Auth0
# OIDC_AUTH_URL= OIDC_TOKEN_URL= OIDC_LOGOUT_URL=  # override bila discovery tidak dipakai
OIDC_JWKS_URL=                               # kosong = discovery dari ISSUER/.well-known/openid-configuration
OIDC_ROLE_CLAIM=roles                        # Keycloak: realm_access.roles ; Entra: roles ; Okta: groups
OIDC_ROLE_MAP={"soc-admin":"admin","soc-analyst":"analyst","soc-viewer":"viewer"}
OIDC_TENANT_CLAIM=tenant_id
ALLOW_STATIC_TOKENS=false
# --- Layanan opsional (kosong = fallback lokal)
REDIS_URL=
ELASTICSEARCH_URL=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password
OLLAMA_URL=                                  # mis. http://ollama:11434
OLLAMA_MODEL=                                # PIN tag spesifik, mis. nama:tag-tetap
PROMPT_VERSION=analysis_v1
BERT_MODEL_PATH=                             # model HF sequence-classification hasil fine-tuning (0=FP,1=true)
# --- Konektor SIEM/EDR (konfigurasi: infra/config/connectors.json; salin dari connectors.example.json)
CONNECTORS_CONFIG=infra/config/connectors.json
EMBEDDED_CONNECTORS=true                    # false bila memakai service `connectors` terpisah
# Secret vendor (contoh; nama bebas, dirujuk lewat *_env di connectors.json). Produksi: gunakan NAMA_FILE (Docker secret)
# SPLUNK_TOKEN=  SENTINEL_CLIENT_SECRET=  QRADAR_TOKEN=  CS_CLIENT_SECRET=  S1_API_TOKEN=  DEFENDER_CLIENT_SECRET=  CORTEX_API_KEY=  WAZUH_INDEXER_PASSWORD=  ELASTIC_API_KEY=
# --- GLPI (aset). Kosong = pakai ASSET_INVENTORY_FILE. Pemetaan field: infra/config/glpi.json (salin glpi.example.json)
GLPI_URL=
GLPI_APP_TOKEN_FILE=/run/secrets/glpi_app_token
GLPI_USER_TOKEN_FILE=/run/secrets/glpi_user_token
GLPI_CONFIG=infra/config/glpi.json
# --- Cluster terkelola Master (opsional; docs/MASTER.md)
MASTER_URL=
CLUSTER_ID=
MASTER_CLUSTER_TOKEN_FILE=/run/secrets/master_cluster_token
MASTER_POLICY_PUBKEY_FILE=/run/secrets/master_policy_pub
POLICY_POLL_SECONDS=60
ENGINE_CLAIM_IDLE_MS=60000                  # klaim ulang pesan milik worker yang mati setelah idle selama ini
# --- Enrichment (GLPI=aset, OpenCTI=IOC)
ASSET_INVENTORY_FILE=data/assets.json
INTEL_FILE=data/intel.json
VULN_FILE=data/vulns.json
OPENCTI_URL=
OPENCTI_TOKEN_FILE=/run/secrets/opencti_token
ENRICHMENT_TIMEOUT=2.0
ENRICHMENT_CACHE_TTL=300
# --- Noise reduction & lingkungan
FFT_MIN_HISTORY_HOURS=48
FFT_PEAK_RATIO=3.0
PCC_THRESHOLD=0.85
ENV_INDUSTRY_CAMPAIGN=false
ENV_NETWORK_WIDE_ANOMALY=false
# --- KB sync
KB_SYNC_HOUR=1
KB_SYNC_TZ=Asia/Jakarta
KB_STALE_DAYS=3
# --- Backup (cron 5 field; credential/key lewat file secret)
BACKUP_ENABLED=true
BACKUP_SCHEDULE_MODE=cron
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_TIMEZONE=Asia/Jakarta
BACKUP_COMPONENTS=postgres,elasticsearch,neo4j,redis
BACKUP_RETENTION_DAYS=30
BACKUP_REPOSITORY_URI=/backups
BACKUP_VERIFY_AFTER_RUN=true
BACKUP_ENCRYPTION_KEY_FILE=/run/secrets/backup_encryption_key   # buat: python -m services.backup.crypto genkey <path>; SIMPAN SALINAN TERPISAH
BACKUP_ES_REPOSITORY=                       # nama snapshot repository ES yang sudah terdaftar
